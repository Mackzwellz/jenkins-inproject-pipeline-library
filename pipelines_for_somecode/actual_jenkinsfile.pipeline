pipeline {
// https://stackoverflow.com/questions/46213913/load-jenkins-pipeline-shared-library-from-same-repository
// https://medium.com/@AndrzejRehmann/private-jenkins-shared-libraries-540abe7a0ab7

    agent any

    parameters {
        string defaultValue: 'https://github.com/Mackzwellz/jenkins-inproject-pipeline-library.git', name: 'REPO_URL', trim: true
        string defaultValue: 'origin/develop', name: 'CODE_BRANCH', trim: true
        string defaultValue: 'origin/develop', name: 'PIPELINE_BRANCH', trim: true
//        gitParameter branch: '', branchFilter: 'origin/(.*)', defaultValue: 'origin/develop', name: 'CODE_BRANCH',
//                quickFilterEnabled: false, selectedValue: 'DEFAULT', sortMode: 'DESCENDING_SMART',
//                type: 'PT_BRANCH', useRepository: "${params.REPO_URL}"
//        gitParameter branch: '', branchFilter: 'origin/(.*)', defaultValue: 'origin/develop', name: 'PIPELINE_BRANCH',
//                quickFilterEnabled: false, selectedValue: 'DEFAULT', sortMode: 'DESCENDING_SMART',
//                type: 'PT_BRANCH',  useRepository: "${params.REPO_URL}"
    }

    stages {
        stage("Checkout") {
            steps {
                cleanWs()
                println("-- execute start")
                println("${params.REPO_URL}")
                println("${params.CODE_BRANCH}")
                println("${params.PIPELINE_BRANCH}")
                git branch: "${params.CODE_BRANCH}", url: "${params.REPO_URL}"
                //checkout scmGit(branches: [[name: "*/${params.CODE_BRANCH}"]], extensions: [], userRemoteConfigs: [[url: "${params.REPO_URL}"]])
            }
        }
        stage("Execute") {
            steps {
                script {
                    println("-- execute start")
                    def localLib = libraryFromLocalRepo().shared_lib_name
                    println(libraryFromLocalRepo())
                    println(localLib)
                    println("-- lib loaded")
                    println(localLib.common_steps.new(this).commonStep())
                    println(localLib.common_steps.commonStep())
                    println(localLib.less_common_steps.lessCommonStep())
                    println("-- steps loaded")
                    println(lessGlobalEnv())
                    println(globalEnv())
                    println("-- envs loaded")
                }
            }
        }
    }
}

// https://github.com/cloudogu/ces-build-lib/blob/develop/Jenkinsfile
// def cesBuildLib = libraryFromLocalRepo().com.cloudogu.ces.cesbuildlib
// def mvn = cesBuildLib.MavenWrapperInDocker.new(this, 'eclipse-temurin:11.0.25_9-jdk-alpine')
def libraryFromLocalRepo1() {
    // Workaround for loading the current repo as shared build lib.
    // Checks out to workspace local folder named like the identifier.
    // We have to pass an identifier with version (which is ignored). Otherwise the build fails.
    library(identifier: 'ces-build-lib@snapshot', retriever: legacySCM(scm))
}

// https://github.com/jenkinsci/workflow-cps-global-lib-plugin/pull/101
// https://www.jenkins.io/doc/pipeline/steps/pipeline-groovy-lib/
// def localLib = libraryFromLocalRepo().shared_lib_name
// localLib.common_steps.commonStep()
// localLib.less_common_steps.lessCommonStep()
// less_global_env()
def libraryFromLocalRepo() {
    library(identifier: "shared_lib_name@${params.PIPELINE_BRANCH}",
            retriever: legacySCM(scm: scm, libraryPath: 'pipelines_for_somecode/in_repo_jenkins_lib'))
}


